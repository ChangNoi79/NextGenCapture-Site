---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, locales, type Locale } from '../../data/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const text = copy[locale];
---
<BaseLayout locale={locale} title={text.meta.privacy} description={text.legal.privacyTitle}><article class="shell legal"><div class="page-head"><h1>{text.legal.privacyTitle}</h1><p>{text.legal.updated}</p></div>{text.legal.privacy.map((paragraph) => <p>{paragraph}</p>)}<p><a href={`/${locale}/`}>{text.legal.back}</a></p></article></BaseLayout>
