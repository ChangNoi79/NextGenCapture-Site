---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, locales, chromeWebStoreUrl, siteIssuesUrl, type Locale } from '../../data/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const text = copy[locale];
---
<BaseLayout locale={locale} current="home" title={text.meta.home} description={text.hero.lead}>
  <section class="hero shell"><div class="eyebrow">{text.hero.eyebrow}</div><h1>{text.hero.title}</h1><p class="lead">{text.hero.lead}</p><div class="actions"><a class="button primary" href={chromeWebStoreUrl}>{text.hero.download}</a><a class="button" href={`/${locale}/roadmap/`}>{text.hero.roadmap}</a></div></section>
  <section class="section" id="features"><div class="shell"><h2>{text.features.title}</h2><p class="section-lead">{text.features.lead}</p><div class="card-grid">{text.features.items.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></section>
  <section class="section"><div class="shell"><h2>{text.product.title}</h2><p class="section-lead">{text.product.lead}</p><div class="product-board"><div class="capture-panel"><div class="panel-label">{text.product.capture}</div><div class="tool-row">{text.product.captureTools.map((tool) => <span>{tool}</span>)}</div></div><div class="editor-panel"><div class="panel-label">{text.product.editor}</div><div class="tool-row">{text.product.editorTools.map((tool) => <span>{tool}</span>)}</div><p class="note">{text.product.privacy}</p></div></div></div></section>
  <section class="section" id="support"><div class="shell support"><div><h2>{text.support.title}</h2><p>{text.support.lead}</p><p class="note">{text.support.note}</p></div><a class="button primary" href={siteIssuesUrl}>{text.support.action}</a></div></section>
</BaseLayout>
