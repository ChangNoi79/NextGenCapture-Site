---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, locales, type Locale } from '../../data/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const text = copy[locale];
---
<BaseLayout locale={locale} title={text.meta.imprint} description={text.legal.imprintTitle}><article class="shell legal"><div class="page-head"><h1>{text.legal.imprintTitle}</h1></div><p class="pending">{text.legal.imprintPending}</p><p><a href={`/${locale}/`}>{text.legal.back}</a></p></article></BaseLayout>
