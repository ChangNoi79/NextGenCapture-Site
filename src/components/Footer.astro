---
import { copy, extensionRepositoryUrl, type Locale } from '../data/site';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const text = copy[locale];
---
<footer class="site-footer">
  <div class="shell footer-inner">
    <span>{text.footer.copyright}</span>
    <div>
      <a href={`/${locale}/privacy/`}>{text.footer.privacy}</a>
      <a href={`/${locale}/imprint/`}>{text.footer.imprint}</a>
      <a href={extensionRepositoryUrl} rel="noreferrer">{text.footer.github}</a>
    </div>
  </div>
</footer>
