---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy, locales, chromeWebStoreUrl, siteIssuesUrl, type Locale } from '../../data/site';
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
const text = copy[locale];
---
<BaseLayout locale={locale} current="home" title={text.meta.home} description={text.hero.lead}>
  <section class="hero-shell"><div class="hero shell"><div class="hero-copy"><div class="eyebrow">{text.hero.eyebrow}</div><h1>{text.hero.title}</h1><p class="lead">{text.hero.lead}</p><ul class="hero-points">{text.hero.points.map((point) => <li>{point}</li>)}</ul><div class="actions"><a class="button primary" href={chromeWebStoreUrl}>{text.hero.download}</a><a class="button" href={`/${locale}/roadmap/`}>{text.hero.roadmap}</a></div></div><div class="hero-visual"><div class="window-chrome"><i></i><i></i><i></i><span>NextGen Capture</span></div><img src="/assets/extension/popup.png" alt={text.hero.imageAlt} loading="eager" /></div></div></section>
  <section class="section" id="features"><div class="shell"><div class="section-heading"><div><div class="eyebrow">NextGen Capture</div><h2>{text.features.title}</h2></div><p class="section-lead">{text.features.lead}</p></div><div class="card-grid">{text.features.items.map((item, index) => <article class="card"><span class="feature-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><div class="eyebrow">Workflow</div><h2>{text.product.title}</h2></div><p class="section-lead">{text.product.lead}</p></div><div class="product-showcase"><div class="editor-shot"><img src="/assets/extension/editor.png" alt={text.product.imageAlt} loading="lazy" /></div><div class="product-board"><div class="capture-panel"><div class="panel-label">{text.product.capture}</div><div class="tool-row">{text.product.captureTools.map((tool) => <span>{tool}</span>)}</div></div><div class="editor-panel"><div class="panel-label">{text.product.editor}</div><div class="tool-row">{text.product.editorTools.map((tool) => <span>{tool}</span>)}</div><p class="note">{text.product.privacy}</p></div></div></div></div></section>
  <section class="section" id="support"><div class="shell support"><div><div class="eyebrow">Support</div><h2>{text.support.title}</h2><p>{text.support.lead}</p><p class="note">{text.support.note}</p></div><div class="support-actions"><a class="button primary" href="mailto:contact@nextgencapture.app">{text.support.emailAction}</a><a class="button" href={siteIssuesUrl}>{text.support.trackerAction}</a></div></div></section>
</BaseLayout>
